/* =============================================================================
 * EVO PLAYER PRO - Toast Notification Stylesheet (RCSS)
 * #75: RmlUi replacement for the CPU-rasterised evo_widget_toast().
 *
 * Rendered in its own Rml::Context, on top of whatever screen is already on
 * screen - see the comment on EvoToastState. The body stays fully
 * transparent so only the card itself ever touches the framebuffer, the same
 * convention playback.rcss uses to composite the OSD over live video.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16dp;
    color: #ffffff;
    background-color: transparent;
    margin: 0;
    padding: 0;
    width: 1920dp;
    height: 1080dp;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Aligned above the playback controls on the 1920×1080 design canvas. */
#toast-card {
    position: absolute;
    bottom: 260dp;
    right: 48dp;
    width: 560dp;
    min-height: 112dp;
    background-color: #10182bf5;
    border-width: 1dp;
    border-color: #2a3c5e;
    border-radius: 0;
    padding: 24dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 18dp;
}

/* Accent rail down the left edge - the same vocabulary a selected menu row
 * uses, so a toast reads as part of the same system. Colour is pushed from
 * C++ (theme accent / accent_alt, or a fixed danger red - see
 * UpdateToastState, EvoThemeColors carries no "danger" channel today). */
#toast-rail {
    width: 6dp;
    align-self: stretch;
    border-radius: 0;
    background-color: #ffcd00;
}

#toast-icon-wrap {
    width: 40dp;
    height: 40dp;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

#toast-icon {
    width: 32dp;
    height: 32dp;
}

/* Column, centred - a title-only toast (no message) centres vertically for
 * free instead of the CPU renderer's measured-baseline math
 * (evo_text_y_centred / evo_text_y_stacked). */
#toast-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
}

#toast-title {
    font-size: 24dp;
    font-weight: bold;
    color: #fff3ec;
    letter-spacing: 0.5dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#toast-message {
    font-size: 20dp;
    font-weight: normal;
    color: #ccb29f;
    margin-top: 4dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* .toast-info / .toast-ok / .toast-error share this layout; only the rail
 * colour, icon and (for tech) text colour vary - all pushed from C++ so they
 * follow the live theme instead of being baked into four static classes. */
.toast-tech #toast-title,
.toast-tech #toast-message {
    color: #8c715e;
}

.toast-action #toast-message {
    white-space: normal;
    max-height: 84dp;
    line-height: 28dp;
}

#toast-actions {
    display: none;
    flex-direction: row;
    gap: 14dp;
    margin-top: 20dp;
}

.toast-action #toast-actions {
    display: flex;
}

#toast-actions span {
    flex: 1 1 0;
    min-width: 0;
    font-size: 18dp;
    padding: 8dp;
    background-color: #ffffff1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#toast-spinner {
    display: none;
    flex-shrink: 0;
    width: 32dp;
    height: 32dp;
    border-width: 4dp;
    border-radius: 16dp;
    border-color: #ffffff26;
}

.toast-busy #toast-spinner {
    display: block;
}

.toast-busy #toast-rail,
.toast-busy #toast-icon-wrap {
    display: none;
}
